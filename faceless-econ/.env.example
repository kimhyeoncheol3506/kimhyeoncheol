# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 Git에 올라가지 않습니다.
# YouTube Data API v3 키 (Google Cloud Console → API 및 서비스 → 사용자 인증 정보)
# 비워 두면 '데모 모드'로 동작합니다.
YOUTUBE_API_KEY=

# [선택] 하루 할당량 상한(기본 10000 단위). 이 값의 90%에 도달하면 수집을 멈춥니다.
# YOUTUBE_DAILY_QUOTA=10000

# [선택] 수집 데이터 저장 폴더 (기본: ./data)
# DATA_DIR=./data
