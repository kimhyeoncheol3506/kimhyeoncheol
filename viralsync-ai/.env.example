# ── 필수 ───────────────────────────────────────────────
# PostgreSQL 연결 문자열
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viralsync?schema=public"
# 세션 쿠키 서명용 비밀값 (32자 이상 임의 문자열, 운영 환경에서 반드시 교체)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ── 데모 모드 ───────────────────────────────────────────
# true 이면 로그인 화면에 데모 계정 원클릭 로그인이 표시됩니다.
DEMO_MODE="true"

# ── AI Provider (선택) ─────────────────────────────────
# 비워 두면 데모(규칙·템플릿) Provider 가 사용됩니다.
AI_PROVIDER="demo"            # demo | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# AI 비용 원화 환산용 환율 (추정치)
USD_KRW_RATE="1400"

# ── SNS 공식 API (선택, 실제 게시용) ────────────────────
# 값이 모두 채워지고 계정 인증이 완료된 플랫폼만 "게시 가능" 상태가 됩니다.
# 현재 MVP 에는 실제 게시 호출이 구현되어 있지 않습니다(README 참고).
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
X_API_KEY=""
X_API_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
BLOG_API_KEY=""

# ── Threads 바로 올리기 ────────────────────────────────
# 이 앱이 외부에서 접속되는 https 주소 (Threads 가 이미지를 여기서 가져감)
PUBLIC_BASE_URL=""
# 토큰 암호화 키 (32자 이상 임의 문자열, 바꾸면 기존 연결을 다시 해야 함)
TOKEN_ENCRYPTION_KEY=""
# Threads 로그인(OAuth) 연결용 — 토큰 붙여넣기만 쓸 경우 생략 가능
THREADS_APP_ID=""
THREADS_APP_SECRET=""
THREADS_REDIRECT_URI=""   # 예: https://내주소/api/threads/callback
# 업로드 이미지 저장 위치 (기본: ./uploads)
UPLOAD_DIR=""
# 데모 원클릭 로그인을 외부 주소(터널·배포)에서도 허용 — 공개 환경에서는 켜지 마세요
DEMO_ALLOW_REMOTE="false"
