# ─────────────────────────────────────────────
#  복사해서 .env 로 이름을 바꾸고 값만 채우세요:  cp .env.example .env
# ─────────────────────────────────────────────

# [필수] 대본 생성 — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# 사용할 Claude 모델 / 생각 깊이(low|medium|high|xhigh|max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# [권장] 유튜브 검색 — https://console.cloud.google.com → "YouTube Data API v3" 사용 설정 → 사용자 인증 정보 → API 키
# 비워 두면 yt-dlp 검색으로 자동 대체(느리지만 키 불필요)
YOUTUBE_API_KEY=

# ─── 음성(TTS) ───  edge(무료, 키 불필요) | elevenlabs | typecast | clova | silent(테스트용 무음)
TTS_PROVIDER=edge
EDGE_VOICE=ko-KR-InJoonNeural
EDGE_RATE=+8%

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
TYPECAST_MODEL=ssfm-v21

# 네이버 클라우드 CLOVA Voice (Premium)
CLOVA_CLIENT_ID=
CLOVA_CLIENT_SECRET=
CLOVA_SPEAKER=nminsang

# ─── 영상 ───
# 자막 폰트 이름 (assets/fonts 에 .ttf/.otf 를 넣으면 그 폰트를 우선 사용)
# Windows: Malgun Gothic / macOS: Apple SD Gothic Neo / 리눅스: Noto Sans CJK KR
SUBTITLE_FONT=Noto Sans CJK KR
# 원본 영상 소리 크기(나레이션 구간). 0.0~1.0
SOURCE_DUCK_VOLUME=0.12
# assets/bgm 폴더의 mp3 하나를 깔고 싶으면 파일명 지정 (비우면 BGM 없음)
BGM_FILE=
BGM_VOLUME=0.08
# ffmpeg 경로를 직접 지정하고 싶을 때만
FFMPEG_PATH=

# ─── yt-dlp (유튜브가 '봇 확인'을 요구할 때만) ───
# 로그인된 브라우저의 쿠키 사용: chrome | edge | firefox | safari
YTDLP_COOKIES_FROM_BROWSER=
# 또는 cookies.txt 파일 경로
YTDLP_COOKIES_FILE=

# ─── 고급 편집 ───
# 무음 제거(앞뒤 무음 삭제 + 문장 사이 쉼 압축)
SILENCE_REMOVE=true
MAX_PAUSE=0.25
# 효과음 크기 (assets/sfx/whoosh.mp3 처럼 같은 이름 파일을 넣으면 기본 합성음 대신 사용)
SFX_VOLUME=0.55
# 더빙 구간에서 원본 소리 크기
DUB_DUCK_VOLUME=0.25
# ElevenLabs/Typecast/CLOVA 캐릭터 목소리: 성별별 보이스 ID 목록(쉼표 구분). edge 는 자동 배정
CHARACTER_VOICES_MALE=
CHARACTER_VOICES_FEMALE=
