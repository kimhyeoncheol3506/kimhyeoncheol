      "visual": {
        "mode": "post",
        "focus": "body1",
        "focus_chunks": {
          "1": "body5"
        }
      }
    },
    {
      "id": "s03",
      "voice": "여의도남자",
      "say": "원서 마지막 날 지방 의대를 써서 붙었고, 지금은 서울 병원에서 수련하고 군의관도 마치고, 대학병원 전문의로 일하고 있습니다.",
      "cap": [
        "*지방 의대* 합격",
        "지금은 *대학병원 전문의*"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "tick",
          5.0
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body9",
        "focus_chunks": {
          "1": "body14"
        }
      }
    },
    {
      "id": "s04",
      "voice": "여의도남자",
      "say": "그런데 아내는, 학벌에 미친 사람 같대요. 누굴 얘기하든 대학부터 말하고, 연예인, 유튜버까지 출신 대학을 다 외우고 있다고요.",
      "cap": [
        "아내는 *학벌에 미친* 사람",
        "누구든 *대학부터* 말한다"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "boom",
          3.0
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body19",
        "focus_chunks": {
          "1": "body23"
        },
        "shake_at_chunk": 0
      }
    },
    {
      "id": "s05",
      "voice": "여의도남자",
      "say": "집엔 학교 마크가 달린 기념품이 가득하고, 아직도 졸업생 도서관 카드를 갖고 있대요. 회사 부장도, 낮은 대학 나온 주제에 운 좋게 자리 차지했다고 깎아내린답니다.",
      "cap": [
        "*학교 기념품*이 가득",
        "부장도 *학벌로 깎아내림*"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "boom",
          8.6
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body28",
        "focus_chunks": {
          "1": "body31"
        }
      }
    },
    {
      "id": "s06",
      "voice": "여의도남자",
      "say": "여기까지 이해 안 되면 댓글에 일. 근데, 그 화살이 남편에게도 꽂힙니다.",
      "cap": [
        "*이해 안 되면* 댓글에 1",
        "화살은 *남편에게도*"
      ],
      "sfx": [
        [
          "pop",
