      ],
      "visual": {
        "mode": "post",
        "focus": "body6",
        "focus_chunks": {
          "1": "body9"
        }
      }
    },
    {
      "id": "s04",
      "voice": "여의도남자",
      "say": "두 달 차엔 여자친구 베프 언니 커플과 함께 놀러 갔고, 회사 복지로 싸게 예약했고, 부산 여행도 전부 직접 계획하고 예약했대요.",
      "cap": [
        "2달 차 *베프 커플* 여행",
        "*부산 여행*도 전부 계획"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "boom",
          8.4
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body12",
        "focus_chunks": {
          "1": "body17"
        }
      }
    },
    {
      "id": "s05",
      "voice": "여의도남자",
      "say": "그리고 석 달 차, 갈등 전날. 여자친구가 감기에 걸렸다고 해서, 쉬는 날 올라가서 간호해 주고, 백숙까지 먹여 줬대요.",
      "cap": [
        "갈등 전날 *감기 간호*",
        "*백숙*까지 먹여줌"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "boom",
          6.6
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body20",
        "focus_chunks": {
          "1": "body21"
        }
      }
    },
    {
      "id": "s06",
      "voice": "여의도남자",
      "say": "그런데 다음 날, 공원에서 빵을 먹은 뒤부터 말이 없던 여자친구가 갑자기 물었대요. 나한테 뭐 잘못한 거 없어?",
      "cap": [
        "*공원*에서 갑자기",
        "*\"내게 잘못한 거 없어?\"*"
      ],
      "sfx": [
        [
          "marker",
