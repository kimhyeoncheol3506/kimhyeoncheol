      "visual": {
        "mode": "post",
        "focus": "body8",
        "focus_chunks": {
          "1": "body9"
        }
      }
    },
    {
      "id": "s03",
      "voice": "여의도남자",
      "say": "칠 개월 전, 이 년 넘게 만난 전 여자친구와 헤어졌고, 잊으려 애쓰다가 소개팅으로 정말 좋은 여자를 만났습니다. 지금 백오십 일째 연애 중.",
      "cap": [
        "7개월 전 *전여친과 이별*",
        "소개팅 *150일 여친*"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "tick",
          4.4
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body13",
        "focus_chunks": {
          "1": "body17"
        }
      }
    },
    {
      "id": "s04",
      "voice": "여의도남자",
      "say": "그런데 잊지 못했던 전 여자친구에게 연락이 왔고, 결국 다시 만나게 됐습니다. 재회 한 달째. 두 사람을 동시에 만나게 된 거예요.",
      "cap": [
        "재회 *한 달째*",
        "*이중 교제* 시작"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "boom",
          3.6
        ],
        [
          "boom",
          8.0
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body20",
        "focus_chunks": {
          "1": "body24"
        },
        "shake_at_chunk": 1
      }
    },
    {
      "id": "s05",
      "voice": "여의도남자",
      "say": "처음엔 둘 중 한 명과는 자연스럽게 끝나겠지, 시간이 지나면 마음도 정리되겠지, 그런 이기적인 생각이었대요. 그런데 둘 다 너무 잘 이어져서 여기까지 왔고, 지금은 죄책감에 잠도 못 잡니다.",
      "cap": [
        "*이기적인 생각*이었다",
        "죄책감에 *잠도 못 잠*"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "boom",
          9.4
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body24",
        "focus_chunks": {
          "1": "body28"
        }
      }
    },
    {
      "id": "s06",
      "voice": "여의도남자",
      "say": "여기까지만 들어도 쓰레기면 댓글에 일. 근데, 두 사람 조건이 진짜 다릅니다.",
      "cap": [
        "*쓰레기*면 댓글에 1",
        "두 여자 *조건이 달라*"
      ],
      "sfx": [
        [
          "pop",
          0.2
        ],
        [
          "riser",
          2.4
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body30"
      }
    },
    {
      "id": "s07",
      "voice": "여의도남자",
      "say": "첫 번째, 소개팅 여자친구. 우리나라에서 가장 큰 대기업, 공부도 잘했고, 능력과 몸매도 좋고, 성격은 진중하고 안정적. 고민을 편하게 털어놓을 수 있는 사람입니다.",
      "cap": [
        "*대기업*, 능력·몸매 *완벽*",
        "*진중하고 안정적*"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "tick",
          5.6
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body35",
        "focus_chunks": {
          "1": "body40"
        }
      }
    },
    {
      "id": "s08",
      "voice": "여의도남자",
      "say": "집도 십 분 거리고, 처음부터 서로 호감이 있었대요. 그런데 가장 큰 문제가 있습니다. 바로, 외모.",
      "cap": [
        "집도 *10분 거리*",
        "그런데 *가장 큰 문제*"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "boom",
          6.6
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body40",
        "focus_chunks": {
          "1": "body44"
        },
        "shake_at_chunk": 1
      }
    },
    {
      "id": "s09",
      "voice": "여의도남자",
      "say": "솔직히 외모가 취향이 아니라서, 이성적인 끌림이 부족하고, 요즘은 스킨십도 많이 피하고 있대요. 사람은 너무 좋은데, 설레지가 않는 겁니다.",
      "cap": [
        "외모가 *취향이 아님*",
        "사람은 좋은데 *끌림 부족*"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "boom",
          6.0
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body46",
        "focus_chunks": {
          "1": "body50"
        }
      }
    },
    {
      "id": "s10",
      "voice": "여의도남자",
      "say": "두 번째, 이 년 넘게 만난 전 여자친구. 외모도 이상형에 가깝고, 티키타카도 잘되고, 지금도 만날 때마다 심장이 뛴대요.",
      "cap": [
        "전여친은 *이상형*에 가까움",
        "만날 때마다 *설렘*"
      ],
      "sfx": [
        [
          "marker",
          0.1
        ],
        [
          "pop",
          5.0
        ]
      ],
      "visual": {
        "mode": "post",
        "focus": "body53",
        "focus_chunks": {
          "1": "body57"
        }
      }
    },
    {
      "id": "s11",
      "voice": "여의도남자",
      "say": "다만 현실 조건은 차이가 큽니다. 성격이 예민하고, 직업 안정성도 부족한데, 내년엔 일을 그만둘 생각이라고 하고요.",
      "cap": [
        "성격 *예민*, 직업 *불안정*",
        "내년에 *일 그만둘 생각*"
      ],
      "sfx": [
        [
          "marker",
